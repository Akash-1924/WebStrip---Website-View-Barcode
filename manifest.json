{
  "manifest_version": 3,
  "name": "Movie Barcode",
  "version": "1.0",
  "description": "Captures average screen color every 3s and builds a movie barcode.",
  "permissions": ["tabs", "storage", "offscreen", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Movie Barcode" }
}